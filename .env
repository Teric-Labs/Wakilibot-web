# Wakilibot AI Agent URL (Render service)
REACT_APP_AGENT_URL=https://wakilibot-agent-0wm0.onrender.com

# Main Backend Service URL (Render service)
REACT_APP_BACKEND_URL=https://wakilibot-main-tum2.onrender.com

# Real-time ASR WebSocket endpoints (defaults shown; override if hosts move)
# REACT_APP_ASR_CONTROL_URL=ws://stt-control.atekervoices.com/control
# REACT_APP_ASR_DATA_URL=ws://stt-data.atekervoices.com

# Spark TTS WebSocket for streaming speech synthesis. wss:// (not ws://): the
# deployed site is https, and a plain ws:// connection from it is blocked as
# mixed content regardless of whether the TTS service itself is reachable.
# REACT_APP_TTS_WS_URL=wss://tts.atekervoices.com/v1/audio/speech/stream/ws
