# WakiliBot Agent API — chat, voice, and conversation endpoints.
# Defaults to the hosted Render service if unset.
REACT_APP_AGENT_URL=https://wakilibot-agent-0wm0.onrender.com

# WakiliBot Core API — auth, complaints, incidents, and documents.
# Defaults to the hosted Render service if unset.
REACT_APP_BACKEND_URL=https://wakilibot-main-tum2.onrender.com

# Real-time ASR WebSocket endpoints.
# Uncomment and override only if the ASR service moves.
# REACT_APP_ASR_CONTROL_URL=ws://stt-control.atekervoices.com/control
# REACT_APP_ASR_DATA_URL=ws://stt-data.atekervoices.com

# Spark TTS streaming WebSocket.
# Use wss:// when the site is served over HTTPS to avoid mixed-content blocks.
# REACT_APP_TTS_WS_URL=wss://tts.atekervoices.com/v1/audio/speech/stream/ws
